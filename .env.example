# Copiază în .env (neversionat). Python îl citește prin common.py, Bun îl încarcă singur din directorul de lucru.

# Pipeline: proxy opțional pentru SEAP, http://user:parola@host:port. Cu „-rotate” în adresă, cererile blocate se reîncearcă.
SEAP_PROXY=

# Server web: adresa publică, fără bară la final. Intră în canonical, sitemap, robots.txt, JSON-LD și în adresele din MCP.
# Fără ea se folosește http://localhost:PORT, deci setează-o înainte de publicare.
SITE_URL=
PORT=3210

# Pune 1 doar când serverul stă în spatele unui proxy de încredere (Cloudflare, Caddy, nginx).
# Atunci adresa clientului se ia din cf-connecting-ip sau din ultima valoare din x-forwarded-for.
TRUST_PROXY=

# Limite pe adresă IP: cereri MCP și pagini, pe minut și pe oră.
MCP_RATE_PER_MIN=90
MCP_RATE_PER_HOUR=1200
PAGE_RATE_PER_MIN=120
PAGE_RATE_PER_HOUR=1500

# Ținta de publicare pentru scripts/publica.sh. Se completează doar în .env, niciodată în repo.
PUBLICA_HOST=
PUBLICA_PORT=22
PUBLICA_URL=
